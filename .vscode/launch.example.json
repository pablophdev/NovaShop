{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "ProductServiceApplication",
            "request": "launch",
            "mainClass": "com.pabloph.product_service.ProductServiceApplication",
            "projectName": "product-service",
            "env": {
                "DB_URL": "jdbc:mysql://localhost:3306/db_products",
                "DB_USERNAME": "root",
                "DB_PASSWORD": "replace-with-local-password"
            }
        },
        {
            "type": "java",
            "name": "CustomerServiceApplication",
            "request": "launch",
            "mainClass": "com.pabloph.customer_service.CustomerServiceApplication",
            "projectName": "customer-service",
            "env": {
                "DB_URL": "jdbc:mysql://localhost:3306/db_customers",
                "DB_USERNAME": "root",
                "DB_PASSWORD": "replace-with-local-password"
            }
        },
        {
            "type": "java",
            "name": "OrderServiceApplication",
            "request": "launch",
            "mainClass": "com.pabloph.order_service.OrderServiceApplication",
            "projectName": "order-service",
            "env": {
                "DB_URL": "jdbc:mysql://localhost:3306/db_orders",
                "DB_USERNAME": "root",
                "DB_PASSWORD": "replace-with-local-password",
                "CUSTOMER_SERVICE_URL": "http://localhost:8081",
                "PRODUCT_SERVICE_URL": "http://localhost:8080"
            }
        },
        {
            "type": "java",
            "name": "MsAuthApplication",
            "request": "launch",
            "mainClass": "com.pabloph.ms_auth.MsAuthApplication",
            "projectName": "ms-auth",
            "env": {
                "DB_URL": "jdbc:mysql://localhost:3306/db_auth",
                "DB_USERNAME": "root",
                "DB_PASSWORD": "replace-with-local-password",
                "JWT_SECRET": "replace-with-local-jwt-secret-at-least-32-characters",
                "JWT_EXPIRATION": "3600000"
            }
        },
        {
            "type": "java",
            "name": "ApiGatewayApplication",
            "request": "launch",
            "mainClass": "com.pabloph.api_gateway.ApiGatewayApplication",
            "projectName": "api-gateway",
            "env": {
                "PRODUCT_SERVICE_URI": "http://localhost:8080",
                "CUSTOMER_SERVICE_URI": "http://localhost:8081",
                "ORDER_SERVICE_URI": "http://localhost:8082",
                "AUTH_SERVICE_URI": "http://localhost:8083",
                "JWT_SECRET": "replace-with-local-jwt-secret-at-least-32-characters"
            }
        }
    ]
}
