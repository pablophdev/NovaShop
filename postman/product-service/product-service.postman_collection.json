{
  "info": {
    "name": "Product Service",
    "description": "Coleccion para probar el microservicio product-service en local.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "categoryId",
      "value": "1"
    },
    {
      "key": "sku",
      "value": "SKU-001"
    }
  ],
  "item": [
