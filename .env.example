# Common
SPRING_PROFILES_ACTIVE=local
PORT=8080

# Database
DB_URL=jdbc:mysql://localhost:3306/database_name
DB_USERNAME=database_user
DB_PASSWORD=database_password

# JWT. Use the same value in ms-auth and api-gateway.
JWT_SECRET=replace-with-a-secure-secret-of-at-least-32-characters
JWT_EXPIRATION=3600000

# API Gateway routes
PRODUCT_SERVICE_URI=http://localhost:8080
CUSTOMER_SERVICE_URI=http://localhost:8081
ORDER_SERVICE_URI=http://localhost:8082
AUTH_SERVICE_URI=http://localhost:8083

# Order Service clients
PRODUCT_SERVICE_URL=http://localhost:8080
CUSTOMER_SERVICE_URL=http://localhost:8081
